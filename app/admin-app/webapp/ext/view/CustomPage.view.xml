<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:unified="sap.ui.unified"
  controllerName="adminapp.adminapp.ext.controller.CustomPage"
  displayBlock="true">

  <Page
    id="customPage"
    title="Custom Page"
    showNavButton="true"
    navButtonPress="onNavBack">

    <content>
      <VBox class="sapUiSmallMargin" id="vboxCustomPage1">
        <Text text="Welcome to the Custom Page!" id="txtCustomPage1" />
        <Button text="Do Something" press="onDoSomething" id="btnCustomPage1" />
      </VBox>
	<VBox id="vbox3">
		<PlanningCalendar
			id="PC1"
			startDate="{customModel>/startDate}"
			rows="{customModel>/people}"
			appointmentsVisualization="Filled"
			appointmentSelect="handleAppointmentSelect"
			showEmptyIntervalHeaders="false"
			showWeekNumbers="true">
			<toolbarContent>
				<Title text="Title" titleStyle="H4" id="title1"/>
			</toolbarContent>
			<rows>
				<PlanningCalendarRow
			id="pcr1"
			icon="{customModel>pic}"
			title="{customModel>name}"
			text="{customModel>role}"
			appointments="{path : 'customModel>appointments', templateShareable: false}"
			intervalHeaders="{path: 'customModel>headers', templateShareable: false}">

			<customData>
				<core:CustomData key="emp-name" value="{customModel>name}" writeToDom="true" id="cd1"/>
			</customData>

			<appointments>
				<unified:CalendarAppointment
					id="ca1"
					startDate="{customModel>start}"
					endDate="{customModel>end}"
					icon="{customModel>pic}"
					title="{customModel>title}"
					text="{customModel>info}"
					type="{customModel>type}"
					tentative="{customModel>tentative}">
				</unified:CalendarAppointment>
			</appointments>

			<intervalHeaders>
				<unified:CalendarAppointment
					id="ca2"
					startDate="{customModel>start}"
					endDate="{customModel>end}"
					icon="{customModel>pic}"
					title="{customModel>title}"
					type="{customModel>type}">
				</unified:CalendarAppointment>
			</intervalHeaders>
		</PlanningCalendarRow>
			</rows>
		</PlanningCalendar>
		<Label text="Add available built-in views to the example:" id="lbl1"/>
		<MultiComboBox
				id="mcb1"
				selectionFinish="handleSelectionFinish"
				width="230px"
				placeholder="Choose built-in views">
			<items>
				<core:Item key="Hour" text="Hour" id="itm1" />
				<core:Item key="Day" text="Day" id="itm2" />
				<core:Item key="Month" text="Month" id="itm3" />
				<core:Item key="Week" text="1 week" id="itm4" />
				<core:Item key="One Month" text="1 month" id="itm5" />
			</items>
		</MultiComboBox>
	</VBox>
    </content>

  </Page>
</mvc:View>
