<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<ComboBox
		id="combo1"
		selectedKey="{inputField}"
		items="{optionData>/options}"
		selectionChange=".onComboBoxChange">
		<core:Item id="item1" key="{optionData>key}" text="{optionData>text}" />
	</ComboBox>
</core:FragmentDefinition>