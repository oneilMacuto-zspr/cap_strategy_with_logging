{
  "_version": "1.65.0",
  "sap.app": {
    "crossNavigation": {
      "semanticObject": "ProductProjection",
      "action": "create"
    },
    "id": "adminapp.adminapp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "subTitle": "{{appSubTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.17.5",
      "toolsId": "ce191f6f-1013-4e99-9ece-a954ab0882a1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "adminapp.adminapp.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "optionData": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "",
        "settings": {}
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ProductProjectionList",
          "target": "ProductProjectionList"
        },
        {
          "pattern": "ProductProjection({key}):?query:",
          "name": "ProductProjectionObjectPage",
          "target": "ProductProjectionObjectPage"
        },
        {
          "name": "CustomPageRoute",
          "pattern": "custompage",
          "target": "CustomPage"
        }
      ],
      "targets": {
        "ProductProjectionList": {
          "type": "Component",
          "id": "ProductProjectionList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ProductProjection",
              "variantManagement": "None",
              "navigation": {
                "ProductProjection": {
                  "detail": {
                    "route": "ProductProjectionObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "multiSelect": true,
                    "selectionMode": "Multi"
                  },
                  "actions": {
                    "new-action": {
                      "press": "adminapp.adminapp.ext.controller.ListReportExt.newAction",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Send"
                    },
                    "sendAllAction": {
                      "press": "adminapp.adminapp.ext.controller.ListReportExt.sendAll",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Send All"
                    }
                  },
                  "columns": {
                    "CustomInput": {
                      "header": "customInput",
                      "width": "10%",
                      "position": {
                        "anchor": "DataField::Price",
                        "placement": "After"
                      },
                      "template": "adminapp.adminapp.ext.fragment.CustomInput"
                    }
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "tableView",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView"
                  },
                  {
                    "key": "tableView1",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#tableView1"
                  }
                ]
              },
              "content": {
                "header": {
                  "actions": {
                    "newHeaderAction": {
                      "press": "adminapp.adminapp.ext.controller.NewHeaderActionHandler.newHeaderActionFn",
                      "visible": true,
                      "enabled": true,
                      "text": "Show Planning Calendar"
                    }
                  }
                }
              }
            }
          }
        },
        "ProductProjectionObjectPage": {
          "type": "Component",
          "id": "ProductProjectionObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "editable": true,
            "createMode": true,
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ProductProjection",
              "content": {
                "body": {
                  "sections": {
                    "ChartFragment": {
                      "template": "adminapp.adminapp.ext.fragment.ChartFragment",
                      "position": {
                        "placement": "After",
                        "anchor": "GeneratedFacet1"
                      },
                      "title": "chart sections"
                    },
                    "ChartFragmentTwo": {
                      "template": "adminapp.adminapp.ext.fragment.NewFragment",
                      "position": {
                        "placement": "After",
                        "anchor": "ChartFragment"
                      },
                      "title": "new sectionssss"
                    }
                  }
                }
              }
            }
          }
        },
        "CustomPage": {
          "viewName": "adminapp.adminapp.ext.view.CustomPage",
          "viewType": "XML",
          "viewId": "CustomPage",
          "transition": "slide"
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "adminapp.adminapp.ext.controller.ListReportCtrlr"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "adminapp.adminapp.ext.controller.ObjectPageCtrlr"
          }
        },
        "sap.ui.viewExtensions": {
          "sap.fe.templates.ListReport.view.ListReport": {
            "BeforeFacet": {
              "className": "sap.ui.core.mvc.View",
              "viewName": "adminapp.adminapp.ext.view.CustomExtension",
              "type": "XML"
            }
          },
          "sap.suite.ui.generic.template.ObjectPage.view.Details": {
            "AfterFacet|ProductProjection|GeneratedFacet1": {
              "className": "sap.ui.core.mvc.View",
              "viewName": "adminapp.adminapp.ext.view.CustomSection",
              "type": "XML",
              "sap.ui.generic.app": {
                "title": "My Custom Section"
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
